+extends HBoxContainer
+class_name StatBar
+
+## Barra de atributo reutilizable: nombre + barra animada + valor. Admite rangos con negativos (Afecto -100..100).
+
+var stat_key: String = ""
+var min_v: int = 0
+var max_v: int = 100
