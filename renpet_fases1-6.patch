+	_portrait.modulate = Color(0.92, 0.86, 1.0) if GameState.abyssal_sync >= 50 else Color.WHITE
+	if _current_window != "" and (_windows[_current_window] as BaseWindow).visible:
+		(_windows[_current_window] as BaseWindow).refresh()
