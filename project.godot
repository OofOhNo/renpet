; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Renpet: La Señora de la Eternidad"
config/description="Simulador de crianza en Godot 4: Renpet, la niña estrella. Fases 1 a 6 (núcleo, mansión, planificación, crisol, vínculos y rivales)."
run/main_scene="res://src/scenes/TitleScreen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://src/core/GameState.gd"
TimeManager="*res://src/core/TimeManager.gd"
Chronicle="*res://src/core/Chronicle.gd"
CatalogDB="*res://src/data/CatalogDB.gd"
RelationshipManager="*res://src/core/RelationshipManager.gd"
RivalMirror="*res://src/core/RivalMirror.gd"
CrucibleManager="*res://src/core/CrucibleManager.gd"
ExplorationCombat="*res://src/core/ExplorationCombat.gd"
TurnExecutor="*res://src/core/TurnExecutor.gd"
SaveManager="*res://src/core/SaveManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/energy_saving/keep_screen_on=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_antialiasing=2
theme/default_font_hinting=0

[locale]

fallback="es"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
